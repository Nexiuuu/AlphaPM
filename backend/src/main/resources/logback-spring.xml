<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- APP -->
    <appender name="APPLICATION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                backend/logs/application/application-%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>

    </appender>


    <!-- REQUESTS -->
    <appender name="REQUESTS_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                backend/logs/requests/requests-%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n</pattern>
        </encoder>

    </appender>


    <root level="INFO">
        <appender-ref ref="APPLICATION_FILE"/>
    </root>

    <logger name="REQUESTS" level="INFO" additivity="false">
        <appender-ref ref="REQUESTS_FILE"/>
    </logger>

</configuration>